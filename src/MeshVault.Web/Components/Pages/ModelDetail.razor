@page "/model/{Id:int}"
@attribute [Authorize(Policy = Policies.View)]
@rendermode InteractiveServer
@inject ModelCatalog Catalog
@inject ModelEditor Editor
@inject ISnackbar Snackbar
@inject SettingsStore Settings
@inject VariantStore Variants
@inject VariantReindexer Reindexer
@inject GroupStore Groups
@inject GroupReconciler GroupReconciler
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDialogService Dialogs

<PageTitle>@(_model?.Name ?? "Model") - MeshVault</PageTitle>

@if (_card is null)
{
    @if (_loaded)
    {
        <MudAlert Severity="Severity.Warning">Model not found.</MudAlert>
    }
    else
    {
        <MudSkeleton Height="120px" />
    }
}
else
{
    <div class="d-flex align-center gap-3 mb-1">
        @* Back to the browse you came from, filters and page intact, rather
           than an unfiltered one. Falls back to plain /browse when this page
           was opened directly and there is nothing to go back to. *@
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small"
                       OnClick="GoBack" title="Back" />

        @if (_editingName && _canEdit)
        {
            <MudTextField @bind-Value="_nameDraft" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Immediate="true" AutoFocus="true" Class="flex-grow-1"
                          OnKeyDown="OnNameKeyDown" Label="Model name" />
            <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Primary"
                           Disabled="@string.IsNullOrWhiteSpace(_nameDraft)"
                           OnClick="SaveName" title="Save name" />
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CancelRename" title="Cancel" />
        }
        else
        {
            <MudText Typo="Typo.h5" Class="flex-grow-1">@Title</MudText>
            @if (_canEdit)
            {
                <MudTooltip Text="Rename this model">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="StartRename" />
                </MudTooltip>
                @if (_model!.NameSetByUser)
                {
                    <MudTooltip Text="Renamed by you. Reset to use the folder name again.">
                        <MudIconButton Icon="@Icons.Material.Filled.Restore" Size="Size.Small"
                                       OnClick="ResetName" />
                    </MudTooltip>
                }
            }
        }
        @if (_model!.SourceUrl is not null)
        {
            <MudButton Href="@_model.SourceUrl" Target="_blank" Size="Size.Small"
                       Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.OpenInNew">
                @(_model.SourceSite ?? "Source")
            </MudButton>
        }
        @if (CanDownload)
        {
            @* A plain link, not an OnClick. Handing a file back through the
               circuit would mean holding all of it in memory first.

               data-enhance-nav="false" is load-bearing on every download link —
               see Downloads in CLAUDE.md. Enhanced navigation fetches an
               internal link, and only on seeing the reply is not HTML does it
               fall back to a real navigation, so the archive is built and sent
               twice and the save dialog waits out the wasted first copy. *@
            <MudTooltip Text="@($"Download every file as a zip ({Formats.Bytes(AllFiles.Sum(f => f.SizeBytes))})")">
                <MudButton Href="@($"/download/model/{_model.Id}")" Size="Size.Small"
                           Variant="Variant.Outlined" data-enhance-nav="false"
                           StartIcon="@Icons.Material.Filled.Download">Download</MudButton>
            </MudTooltip>
        }
        @if (_canEdit)
        {
            <MudTooltip Text="@(_card.IsFavorite ? "Remove from favorites" : "Add to favorites")">
                <MudIconButton Icon="@(_card.IsFavorite ? Icons.Material.Filled.Star : Icons.Material.Filled.StarBorder)"
                               Color="@(_card.IsFavorite ? Color.Warning : Color.Default)"
                               OnClick="ToggleFavorite" />
            </MudTooltip>
        }
    </div>

    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-1" Style="font-family:ui-monospace,monospace">
        @_model.Library?.Name / @(IsGroup ? Paths.CommonParent(_members.Select(m => m.RelativePath)) : _model.RelativePath)
    </MudText>
    @if (IsGroup)
    {
        <div class="d-flex align-center gap-2 mb-6">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Class="ma-0">
                @_members.Count folders
            </MudChip>
            @* No "Ungroup" any more. Grouping is read from the files rather
               than approved once, so breaking a group apart would only last
               until the next scan put it back -- a button that undoes itself is
               worse than none. What actually separates two of these is
               correcting a sculpt, which is where the grouping comes from. *@
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Separate folders holding the same sculpt, shown together. Nothing was moved
                @if (_canEdit)
                {
                    <text>&mdash; correct a file's sculpt below to separate them.</text>
                }
            </MudText>
        </div>
    }
    else
    {
        <div class="mb-6"></div>
    }

    <MudGrid Spacing="4">
        <MudItem xs="12" md="7" lg="8">
            @if (_sculpts.Count > 0)
            {
                <MudPaper Outlined="true" Class="pa-4 mb-4">
                    <MudText Typo="Typo.overline" Class="mud-text-secondary">Preview</MudText>
                    <div class="mt-2">
                        <ModelViewer ModelId="_model.Id" Sculpts="_sculpts"
                                     SavedView="SavedView"
                                     CanEdit="_canEdit"
                                     OnSnapshotSaved="OnSnapshotSaved" @key="_model.Id" />
                    </div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">
                        Drag to rotate, right-drag to pan, scroll to zoom.
                        @if (_canEdit)
                        {
                            <text>
                                "Set as image" uses the angle you are looking at, and reopening this
                                model returns to it.
                            </text>
                        }
                    </MudText>
                </MudPaper>
            }

            @* Sculpts before files, because that is what somebody came here to
               look at: which minis this folder holds, and which cut of each one
               they own. The file table below is the same rows seen as bytes on
               a disk, which is a different and rarer question. *@
            @if (_sculpts.Count > 0 || _unnamed.Count > 0)
            {
                <SculptPanel ModelId="_model.Id" Sculpts="_sculpts" Unnamed="_unnamed"
                             Variants="_variants" CanEdit="_canEdit"
                             OnChanged="OnSculptsChanged" />
            }

            <MudPaper Outlined="true" Class="pa-4">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Files</MudText>
                <MudTable Items="OrderedFiles" Dense="true" Hover="true" Elevation="0"
                          Breakpoint="Breakpoint.Sm" Class="mt-2" GroupBy="FileGroups">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Variant</MudTh>
                        <MudTh>Kind</MudTh>
                        <MudTh Style="text-align:right">Size</MudTh>
                        <MudTh>Modified</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <GroupHeaderTemplate>
                        <MudTh Class="mud-table-cell-custom-group" colspan="6">
                            <div class="d-flex align-center gap-2">
                                <MudText Typo="Typo.body2" Style="font-weight:600">@context.Key</MudText>
                                @* One sculpt out of a pack of ninety-eight is the
                                   ordinary thing to want. Only headings that name a
                                   sculpt get this; the rest are file kinds. *@
                                @if (CanDownload && SculptKeyFor(context.Key?.ToString()) is { } sculptKey)
                                {
                                    <MudTooltip Text="Download every export of this sculpt">
                                        <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small"
                                                       Href="@($"/download/sculpt/{_model.Id}?key={Uri.EscapeDataString(sculptKey)}")"
                                                       data-enhance-nav="false" />
                                    </MudTooltip>
                                }
                            </div>
                        </MudTh>
                    </GroupHeaderTemplate>
                    <RowTemplate>
                            <MudTd DataLabel="Name">
                                <MudTooltip Text="@context.RelativePath">
                                    <MudText Typo="Typo.caption" Style="font-family:ui-monospace,monospace">
                                        @context.FileName
                                    </MudText>
                                </MudTooltip>
                            </MudTd>
                            <MudTd DataLabel="Variant">
                                @if (context.SculptKey is not null)
                                {
                                    <div class="d-flex align-center gap-1">
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            @(context.VariantLabel ?? "Plain")
                                        </MudText>
                                        @if (context.VariantSetByUser)
                                        {
                                            <MudTooltip Text="Set by hand. Rescans and vocabulary changes leave this alone.">
                                                <MudIcon Icon="@Icons.Material.Filled.PushPin" Size="Size.Small"
                                                         Class="mud-text-secondary" />
                                            </MudTooltip>
                                        }
                                    </div>
                                }
                            </MudTd>
                            <MudTd DataLabel="Kind">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                         Color="@KindColor(context.Kind)" Class="ma-0">@context.Kind</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Size" Style="text-align:right">
                                <MudText Typo="Typo.caption">@Formats.Bytes(context.SizeBytes)</MudText>
                            </MudTd>
                            <MudTd DataLabel="Modified">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @context.ModifiedUtc.LocalDateTime.ToString("d MMM yyyy")
                                </MudText>
                            </MudTd>
                            <MudTd Style="text-align:right">
                                @if (CanDownload)
                                {
                                    <MudTooltip Text="@($"Download {context.FileName}")">
                                        <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small"
                                                       Href="@($"/download/file/{context.Id}")"
                                                       data-enhance-nav="false" />
                                    </MudTooltip>
                                }
                            </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>

            @if (_canEdit)
            {
                <MudPaper Outlined="true" Class="pa-4 mt-4">
                    <MudText Typo="Typo.overline" Class="mud-text-secondary">Notes</MudText>
                    <MudTextField @bind-Value="_notes" Lines="6" Variant="Variant.Outlined" Immediate="true"
                                  Margin="Margin.Dense" Class="my-2"
                                  Placeholder="Print settings, supports, what worked..." />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               Disabled="@(!NotesChanged)" OnClick="SaveNotes">Save notes</MudButton>
                </MudPaper>
            }
            else if (!string.IsNullOrWhiteSpace(_model.Notes))
            {
                <MudPaper Outlined="true" Class="pa-4 mt-4">
                    <MudText Typo="Typo.overline" Class="mud-text-secondary">Notes</MudText>
                    <MudText Typo="Typo.body2" Class="mt-2" Style="white-space:pre-wrap">@_model.Notes</MudText>
                </MudPaper>
            }
        </MudItem>

        <MudItem xs="12" md="5" lg="4">
            @* A signed-out visitor sees what is recorded, not the form that
               changes it. Every control below writes something shared. *@
            @if (!_canEdit)
            {
                <MudPaper Outlined="true" Class="pa-4 mb-4">
                    <MudText Typo="Typo.overline" Class="mud-text-secondary">Source</MudText>
                    <MudSimpleTable Dense="true" Elevation="0" Class="mt-2">
                        <tbody>
                            <tr>
                                <td class="mud-text-secondary">Designer</td>
                                <td>@(_model.Designer?.Name ?? "—")</td>
                            </tr>
                            <tr>
                                <td class="mud-text-secondary">License</td>
                                <td>@(_model.License ?? "—")</td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                </MudPaper>

                @if (AllTags.Any())
                {
                    <MudPaper Outlined="true" Class="pa-4 mb-4">
                        <MudText Typo="Typo.overline" Class="mud-text-secondary">Tags</MudText>
                        <div class="d-flex flex-wrap gap-1 mt-2">
                            @foreach (var tag in AllTags)
                            {
                                <MudChip T="string" Size="Size.Small" Class="ma-0" Color="Color.Primary"
                                         Variant="Variant.Outlined">@tag.Name</MudChip>
                            }
                        </div>
                    </MudPaper>
                }
            }
            else
            {
            <MudPaper Outlined="true" Class="pa-4 mb-4">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Source</MudText>

                @* MaxItems null, or MudBlazor caps the list at ten of its own
                   accord however many the search returns. *@
                <MudAutocomplete T="string" Value="_designerName" ValueChanged="SetDesigner"
                                 SearchFunc="SearchDesigners" Label="Designer" Variant="Variant.Outlined"
                                 Margin="Margin.Dense" Class="mt-2" Clearable="true" CoerceValue="true"
                                 MaxItems="null"
                                 HelperText="Pick from the list, or type a new name to create them" />

                <MudTextField @bind-Value="_sourceUrl" Label="Source URL" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Class="mt-3" Immediate="true"
                              Placeholder="makerworld.com/models/..."
                              Error="@(_sourceError is not null)" ErrorText="@_sourceError"
                              HelperText="Where you downloaded it from" />

                <MudTextField @bind-Value="_license" Label="License" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Class="mt-3" Immediate="true"
                              Placeholder="CC BY-NC 4.0" />

                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="mt-3"
                           Disabled="@(!SourceChanged)" OnClick="SaveSource">Save source</MudButton>
            </MudPaper>

            <MudPaper Outlined="true" Class="pa-4 mb-4">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Tags</MudText>
                <div class="d-flex flex-wrap gap-1 my-2">
                    @foreach (var tag in AllTags)
                    {
                        var tagId = tag.Id;
                        <MudChip T="string" Size="Size.Small" Class="ma-0" Color="Color.Primary"
                                 Variant="Variant.Outlined" OnClose="@(() => RemoveTag(tagId))">
                            @tag.Name
                        </MudChip>
                    }
                    @if (!AllTags.Any())
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">No tags yet.</MudText>
                    }
                </div>
                <MudAutocomplete T="string" Value="_newTag" ValueChanged="AddTag" SearchFunc="SearchTags"
                                 Placeholder="Add a tag..." Variant="Variant.Outlined" Margin="Margin.Dense"
                                 CoerceValue="true" Clearable="true" />
            </MudPaper>

            <MudPaper Outlined="true" Class="pa-4 mb-4">
                <div class="d-flex align-center justify-space-between">
                    <MudText Typo="Typo.overline" Class="mud-text-secondary">Collections</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                   OnClick="CreateCollectionInline" title="New collection" />
                </div>
                @if (_allCollections.Count == 0)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        No collections yet. Create one to group models.
                    </MudText>
                }
                else
                {
                    @foreach (var entry in _allCollections)
                    {
                        var collectionId = entry.Collection.Id;
                        var isMember = _model.Collections.Any(c => c.Id == collectionId);
                        var isPrimary = _model.PrimaryCollection?.Id == collectionId;

                        <div class="d-flex align-center">
                            <MudCheckBox T="bool" Value="isMember" Dense="true" Size="Size.Small"
                                         ValueChanged="@(v => SetCollection(collectionId, v))"
                                         Label="@entry.Collection.Name" Class="flex-grow-1" />

                            @* Only where there is a choice to make. A model in
                               one collection is filed under it whether or not a
                               star says so, and a control that changes nothing
                               invites somebody to press it and wonder. *@
                            @if (isMember && _canEdit && _model.Collections.Count > 1)
                            {
                                <MudTooltip Text="@(isPrimary
                                    ? "Names this model's folder. Click to stop filing it by collection."
                                    : $"File this model under {entry.Collection.Name}")">
                                    <MudIconButton Size="Size.Small"
                                                   Icon="@(isPrimary
                                                       ? Icons.Material.Filled.Star
                                                       : Icons.Material.Filled.StarBorder)"
                                                   Color="@(isPrimary ? Color.Warning : Color.Default)"
                                                   OnClick="@(() => SetPrimaryCollection(isPrimary ? null : collectionId))" />
                                </MudTooltip>
                            }
                        </div>
                    }

                    @* A model lives in one folder and can be in any number of
                       collections, so the star is the whole answer to which one
                       names it. Said out loud, because otherwise the only place
                       the consequence shows up is a destination path on the
                       organize page. *@
                    @if (_model.Collections.Count > 1)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
                            @if (_model.PrimaryCollection is { } primary)
                            {
                                <text>Filed under <strong>@primary.Name</strong> where your folder
                                template uses <code>{collection}</code>.</text>
                            }
                            else
                            {
                                <text>
                                    No collection starred, so <code>{collection}</code> is left out
                                    of this model's folder entirely. Star one to file it.
                                </text>
                            }
                        </MudText>
                    }
                }
                @if (_newCollection is not null)
                {
                    <div class="d-flex gap-2 align-center mt-2">
                        <MudTextField @bind-Value="_newCollection" Placeholder="Collection name"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                      OnKeyDown="OnNewCollectionKeyDown" />
                        <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Primary"
                                       Size="Size.Small" OnClick="SaveNewCollection" />
                    </div>
                }
            </MudPaper>
            }

            @if (_paintsEnabled)
            {
                <PaintSchemes ModelId="_model.Id" UserName="@_userName" CanEdit="_canEdit" @key="_model.Id" />
            }

            <MudPaper Outlined="true" Class="pa-4">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Details</MudText>
                <MudSimpleTable Dense="true" Elevation="0" Class="mt-2">
                    <tbody>
                        <tr><td class="mud-text-secondary">Size</td><td>@Formats.Bytes(_model.TotalBytes)</td></tr>
                        <tr><td class="mud-text-secondary">Files</td><td>@AllFiles.Count()</td></tr>
                        @if (SculptCount > 0)
                        {
                            <tr>
                                <td class="mud-text-secondary">Sculpts</td>
                                <td>@SculptCount</td>
                            </tr>
                        }
                        <tr><td class="mud-text-secondary">Added</td><td>@Formats.Ago(_model.AddedUtc)</td></tr>
                        <tr><td class="mud-text-secondary">Modified</td><td>@Formats.Ago(_model.FileModifiedUtc)</td></tr>
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public int Id { get; set; }

    private ModelCard? _card;
    private ModelEntry? _model => _card?.Model;
    private bool _loaded;
    private List<(Collection Collection, int Count)> _allCollections = [];

    // Painting is optional and off by default, so the panel appears only when
    // an administrator has turned it on.
    private bool _paintsEnabled;
    private string? _userName;

    /// <summary>
    /// False for a signed-out visitor on a publicly readable instance. Every
    /// control it hides writes something, and in Blazor Server a handler that
    /// was never rendered cannot be invoked, so not drawing them is the guard
    /// rather than a disguise for one.
    /// </summary>
    private bool _canEdit;

    private string _newTag = "";
    private string _notes = "";
    private string _originalNotes = "";
    private string _designerName = "";
    private string _sourceUrl = "";
    private string _originalSourceUrl = "";
    private string _license = "";
    private string _originalLicense = "";
    private string? _sourceError;
    private string? _newCollection;
    private bool _editingName;
    private string _nameDraft = "";

    private bool NotesChanged => _notes != _originalNotes;
    private bool SourceChanged => _sourceUrl != _originalSourceUrl || _license != _originalLicense;

    /// <summary>
    /// Meshes gather under the sculpt they are exports of, best export first;
    /// everything else gathers under its kind. Ordering has to match the
    /// grouping or a group's rows arrive in several pieces.
    /// </summary>
    private IEnumerable<ModelFile> OrderedFiles =>
        AllFiles
            .OrderBy(f => f.Kind)
            .ThenBy(f => FileGroupKey(f), StringComparer.OrdinalIgnoreCase)
            .ThenBy(f => f.VariantRank)
            .ThenBy(f => f.FileName, StringComparer.OrdinalIgnoreCase);

    private static readonly TableGroupDefinition<ModelFile> FileGroups = new()
    {
        Indentation = false,
        Expandable = false,
        Selector = FileGroupKey,
    };

    // Correcting a file's sculpt or variant ---------------------------------
    //
    // Detection reads names well but not perfectly: a creator's typo splits one
    // sculpt across two headings, and no vocabulary can spell-check. This is the
    // way out, and what it sets is pinned against every later pass.

    // Variant groups --------------------------------------------------------
    //
    // A group is several folders holding the same sculpt. This page stands for
    // all of them: the viewer, the file table and the tags read across every
    // member, while the row being edited stays the primary. Empty for the great
    // majority of models, which belong to no group.

    private List<ModelEntry> _members = [];

    private bool IsGroup => _members.Count > 1;

    private string Title => IsGroup ? _model!.GroupName ?? _model.Name : _model!.Name;

    /// <summary>Every file this page stands for, across the whole group.</summary>
    private IEnumerable<ModelFile> AllFiles =>
        IsGroup ? _members.SelectMany(m => m.Files) : _model!.Files;

    /// <summary>
    /// Tags on any member. They fan out on write, so this only differs from one
    /// member's tags for a group whose folders were tagged before it existed.
    /// </summary>
    private IEnumerable<Tag> AllTags =>
        IsGroup
            ? _members.SelectMany(m => m.Tags).DistinctBy(t => t.Id).OrderBy(t => t.Name)
            : _model!.Tags;

    /// <summary>
    /// Steps back through the browser's own history, which is where the browse
    /// filters live now that they are in the address bar.
    /// </summary>
    /// <remarks>
    /// A link to /browse would land on an unfiltered grid and lose the search,
    /// tags and page somebody had set. Guarded on there being history to step
    /// through: opening a model page directly must not walk out of the app.
    /// </remarks>
    private async Task GoBack()
    {
        try
        {
            if (await JS.InvokeAsync<bool>("meshvaultCanGoBack"))
            {
                await JS.InvokeVoidAsync("history.back");
                return;
            }
        }
        catch (JSException)
        {
            // No script, or a circuit that has gone: fall through to the grid.
        }

        Nav.NavigateTo("/browse");
    }

    private List<VariantDefinition> _variants = [];

    /// <summary>
    /// Meshes carrying no sculpt, which the planner will not file.
    /// </summary>
    /// <remarks>
    /// Kept beside the sculpts rather than buried in the file table, because
    /// the only place their absence otherwise shows up is organizing refusing
    /// to move them, one page away and with nothing to act on.
    /// </remarks>
    private List<ModelFile> _unnamed = [];

    /// <summary>
    /// Reloads after the sculpt panel has changed something, and settles the
    /// grouping that change may have made or broken.
    /// </summary>
    private async Task OnSculptsChanged()
    {
        await GroupReconciler.ReconcileAsync(_model!.LibraryId);
        await LoadAsync();
    }

    /// <summary>
    /// How many distinct sculpts this model holds. "200 files" says nothing
    /// about a pack that is forty minis exported five ways.
    /// </summary>
    private int SculptCount =>
        AllFiles.Where(f => f.SculptKey is not null)
            .Select(f => f.SculptKey)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

    private static string FileGroupKey(ModelFile file) =>
        string.IsNullOrWhiteSpace(file.SculptName) ? file.Kind.ToString() : file.SculptName!;

    /// <summary>
    /// Whether to offer downloads. Signed in, which is a step up from what this
    /// page needs: public browsing hands a visitor a decimated preview, and
    /// handing over the creator's original file is a different thing to leave
    /// open. The endpoint enforces this too — this only keeps the buttons off a
    /// page where they would 401.
    /// </summary>
    private bool CanDownload => _canEdit;

    /// <summary>
    /// The sculpt key behind a file-table heading, or null when the heading is a
    /// file kind rather than a sculpt. Sculpt keys are the lowercased name, so a
    /// heading maps to exactly one.
    /// </summary>
    private string? SculptKeyFor(string? heading) =>
        heading is null
            ? null
            : AllFiles.FirstOrDefault(
                f => f.SculptKey is not null && FileGroupKey(f) == heading)?.SculptKey;

    /// <summary>
    /// The sculpts the browser viewer can render, each holding every export of
    /// it this model ships. Rebuilt by <see cref="LoadAsync"/>.
    /// </summary>
    private List<SculptGroup> _sculpts = [];

    /// <summary>
    /// The angle this model's card image was taken from, so the viewer opens on
    /// it. Null until someone has set an image with a viewer new enough to have
    /// recorded where it was standing.
    /// </summary>
    private double[]? SavedView =>
        _model is { SnapshotViewX: { } x, SnapshotViewY: { } y, SnapshotViewZ: { } z }
            ? [x, y, z]
            : null;

    private async Task OnSnapshotSaved() => await LoadAsync();

    // Renaming --------------------------------------------------------------

    private void StartRename()
    {
        _nameDraft = _model!.Name;
        _editingName = true;
    }

    private void CancelRename() => _editingName = false;

    private async Task OnNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveName();
        else if (e.Key == "Escape") CancelRename();
    }

    private async Task SaveName()
    {
        if (_model is null || string.IsNullOrWhiteSpace(_nameDraft)) return;

        await Editor.RenameAsync(_model.Id, _nameDraft);
        _editingName = false;
        await LoadAsync();
        Snackbar.Add("Name saved", Severity.Success);
    }

    private async Task ResetName()
    {
        if (_model is null) return;

        await Editor.ResetNameAsync(_model.Id);
        await LoadAsync();
        Snackbar.Add("Name reset to the folder name", Severity.Info);
    }

    protected override async Task OnInitializedAsync()
    {
        _paintsEnabled = await Settings.GetBoolAsync(SettingKeys.PaintsEnabled);

        // Recorded on any scheme written here, so a shared recipe has a face
        // rather than an opaque account id.
        var state = await AuthState.GetAuthenticationStateAsync();
        _userName = state.User.Identity?.Name;
        _canEdit = state.User.Identity?.IsAuthenticated ?? false;
    }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _card = await Catalog.GetAsync(Id);
        _allCollections = await Catalog.GetCollectionsAsync();
        _loaded = true;
        _sculpts = [];
        _members = [];

        if (_model is null) return;

        // Worked out once per load rather than per render: a pack of two hundred
        // files would regroup itself on every keystroke in the notes box.
        _members = await Catalog.GetGroupMembersAsync(Id);
        _sculpts = VariantGrouper.Group(
            AllFiles.Where(f => MeshLoader.CanRead(f.Extension) && f.SculptKey is not null));

        _unnamed = AllFiles
            .Where(f => f.Kind is FileKind.Mesh or FileKind.Cad && f.SculptKey is null)
            .OrderBy(f => f.FileName, StringComparer.OrdinalIgnoreCase)
            .ToList();
        _variants = await Variants.GetAsync();

        _notes = _originalNotes = _model.Notes ?? "";
        _sourceUrl = _originalSourceUrl = _model.SourceUrl ?? "";
        _license = _originalLicense = _model.License ?? "";
        _designerName = _model.Designer?.Name ?? "";
    }

    private static Color KindColor(FileKind kind) => kind switch
    {
        FileKind.Mesh => Color.Primary,
        FileKind.Cad => Color.Secondary,
        FileKind.Sliced => Color.Success,
        FileKind.Image => Color.Warning,
        _ => Color.Default,
    };

    private async Task ToggleFavorite()
    {
        if (_model is null) return;
        await Editor.ToggleFavoriteAsync(_model.Id);
        await LoadAsync();
    }

    // Tags ------------------------------------------------------------------

    private async Task<IEnumerable<string>> SearchTags(string value, CancellationToken ct)
    {
        var tags = await Editor.SuggestTagsAsync(value ?? "", 10, ct);
        return tags.Select(t => t.Name);
    }

    private async Task AddTag(string? value)
    {
        if (_model is null || string.IsNullOrWhiteSpace(value)) return;
        await Editor.AddTagAsync(_model.Id, value);
        _newTag = "";
        await LoadAsync();
    }

    private async Task RemoveTag(int tagId)
    {
        if (_model is null) return;
        await Editor.RemoveTagAsync(_model.Id, tagId);
        await LoadAsync();
    }

    // Designer / source -----------------------------------------------------

    private async Task<IEnumerable<string>> SearchDesigners(string value, CancellationToken ct)
    {
        // No cap. The whole list is what makes picking possible instead of
        // typing, and typing is what creates a designer nobody meant.
        var designers = await Editor.SuggestDesignersAsync(value ?? "", limit: null, ct);
        return designers.Select(d => d.Name);
    }

    /// <summary>
    /// Assigns the designer, asking first when the name is one the library has
    /// never seen.
    /// </summary>
    /// <remarks>
    /// CoerceValue takes whatever is in the box when it loses focus, matched or
    /// not, and SetDesignerAsync creates any name it does not recognise. Between
    /// them, typing "Ci" to find Cinderwing3D and then clicking away created a
    /// designer called "Ci" and assigned the model to it. Coercion still stands
    /// -- typing a genuinely new name is a real thing to want -- but creating
    /// one is now something you say yes to.
    /// </remarks>
    private async Task SetDesigner(string? name)
    {
        if (_model is null) return;

        var chosen = (name ?? "").Trim();

        if (chosen.Length > 0 && !await Editor.DesignerExistsAsync(chosen))
        {
            var confirmed = await Dialogs.ShowMessageBoxAsync(
                $"Create {chosen}?",
                "No designer by that name exists yet, so this will make one. If you were part "
                + "way through typing a name that already exists, cancel and pick it from the list.",
                yesText: "Create", noText: null, cancelText: "Cancel");

            if (confirmed != true)
            {
                // Put the field back to what the model actually says. The
                // control is Value/ValueChanged rather than @bind precisely so
                // that a rejected edit can be refused rather than merely undone
                // afterwards.
                _designerName = _model.Designer?.Name ?? "";
                return;
            }
        }

        _designerName = chosen;
        await Editor.SetDesignerAsync(_model.Id, _designerName);
        await LoadAsync();
        Snackbar.Add(string.IsNullOrWhiteSpace(_designerName) ? "Designer cleared" : $"Designer set to {_designerName}",
            Severity.Success);
    }

    private async Task SaveSource()
    {
        if (_model is null) return;
        _sourceError = null;

        if (!await Editor.SetSourceUrlAsync(_model.Id, _sourceUrl))
        {
            _sourceError = "That does not look like a web address.";
            return;
        }

        await Editor.SetLicenseAsync(_model.Id, _license);
        await LoadAsync();
        Snackbar.Add("Source saved", Severity.Success);
    }

    // Collections -----------------------------------------------------------

    private void CreateCollectionInline() => _newCollection = "";

    private async Task OnNewCollectionKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveNewCollection();
    }

    private async Task SaveNewCollection()
    {
        if (_model is null || string.IsNullOrWhiteSpace(_newCollection)) { _newCollection = null; return; }

        try
        {
            var collection = await Editor.CreateCollectionAsync(_newCollection);
            await Editor.SetCollectionMembershipAsync(_model.Id, collection.Id, true);
            _newCollection = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task SetCollection(int collectionId, bool member)
    {
        if (_model is null) return;
        await Editor.SetCollectionMembershipAsync(_model.Id, collectionId, member);
        await LoadAsync();
    }

    /// <summary>Stars the collection that names this model's folder, or clears it.</summary>
    private async Task SetPrimaryCollection(int? collectionId)
    {
        if (_model is null) return;
        await Editor.SetPrimaryCollectionAsync(_model.Id, collectionId);
        await LoadAsync();
    }

    // Notes -----------------------------------------------------------------

    private async Task SaveNotes()
    {
        if (_model is null) return;
        await Editor.SetNotesAsync(_model.Id, string.IsNullOrWhiteSpace(_notes) ? null : _notes);
        _originalNotes = _notes;
        Snackbar.Add("Notes saved", Severity.Success);
    }
}
