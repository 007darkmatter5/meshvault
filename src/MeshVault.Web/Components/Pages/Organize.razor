@page "/libraries/{LibraryId:int}/organize"
@attribute [Authorize(Policy = Policies.Admin)]
@rendermode InteractiveServer
@implements IDisposable
@inject ModelCatalog Catalog
@inject OrganizePlanner Planner
@inject ModelEditor Editor
@inject OrganizeService Organizer
@inject ISnackbar Snackbar

<PageTitle>Organize - MeshVault</PageTitle>

<div class="d-flex align-center gap-3 mb-1">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/libraries" Size="Size.Small" />
    <MudText Typo="Typo.h5">Organize @(_library?.Name ?? "library")</MudText>
</div>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">
    Work out where every model would go, then apply it. Reading the plan changes nothing; only the
    button at the bottom moves a file, and only when the library allows it.
</MudText>

@if (_library is null)
{
    <MudAlert Severity="Severity.Warning">That library does not exist.</MudAlert>
}
else
{
    <MudGrid Spacing="4">
        <MudItem xs="12" md="5" lg="4">
            <MudPaper Outlined="true" Class="pa-5">
                <MudStack Spacing="4">
                    @* Picking and authoring are two ways of answering the same
                       question, not a thing and a detail of it. Whichever you
                       are doing, the other is noise -- so only one is on
                       screen. *@
                    <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true"
                             @bind-ActivePanelIndex="_tab" Class="organize-modes">
                        <MudTabPanel Text="Presets" Icon="@Icons.Material.Filled.AutoAwesome">
                            <MudText Typo="Typo.subtitle1" Class="mb-1 mt-3">
                                How should this library be laid out?
                            </MudText>

                            <MudRadioGroup T="string" Value="@_preset?.Name" ValueChanged="ApplyPreset">
                                @foreach (var preset in OrganizePresets.All)
                                {
                                    <MudRadio T="string" Value="@preset.Name" Color="Color.Primary"
                                              Dense="true" Class="organize-preset">
                                        <div class="d-flex align-center gap-2 flex-wrap">
                                            <MudText Typo="Typo.body2">@preset.Name</MudText>
                                            @* Which one this library remembers,
                                               said on the row it is true of.
                                               A note at the foot of the list
                                               could only ever be read as
                                               belonging to the row above it. *@
                                            @if (_savedPreset?.Name == preset.Name)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Success"
                                                         Variant="Variant.Text" Class="ma-0"
                                                         Icon="@Icons.Material.Filled.CloudDone">
                                                    saved
                                                </MudChip>
                                            }
                                            @if (preset.Rules.RenameFiles)
                                            {
                                                @* The one destructive choice,
                                                   said out loud where it is
                                                   picked. *@
                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                                                         Variant="Variant.Outlined" Class="ma-0">
                                                    renames files
                                                </MudChip>
                                            }
                                        </div>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                                            @preset.Summary
                                        </MudText>
                                        <MudText Typo="Typo.caption" Class="organize-preset-example d-block">
                                            @preset.Example
                                        </MudText>
                                    </MudRadio>
                                }
                            </MudRadioGroup>

                            @* Reachable by coming back here from Custom, so it
                               has to say why nothing is selected rather than
                               look broken. *@
                            @if (_preset is null)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small"
                                             Class="mr-1" Style="vertical-align:text-bottom" />
                                    Your template is your own — none of these matches it. Picking one
                                    would replace it.
                                </MudText>
                            }
                        </MudTabPanel>

                        <MudTabPanel Text="Custom" Icon="@Icons.Material.Filled.Tune">
                            <MudStack Spacing="4" Class="pt-4">
                                <MudTextField @bind-Value="_folderTemplate" Label="Folder for each model"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                              DebounceInterval="400" OnDebounceIntervalElapsed="Replan"
                                              Error="@(_folderProblems.Count > 0)"
                                              ErrorText="@string.Join(", ", _folderProblems)"
                                              HelperText="Slashes make folders. Relative to the library root." />

                                <MudSelect T="NameCase" Value="_folderCase" ValueChanged="OnFolderCaseChanged"
                                           Label="Folder naming" Variant="Variant.Outlined" Margin="Margin.Dense"
                                           ToStringFunc="NameCasing.Label"
                                           HelperText="Applied to each folder in the path, separately.">
                                    @foreach (var (choice, label, example) in NameCasing.Choices)
                                    {
                                        <MudSelectItem T="NameCase" Value="@choice">
                                            @label
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary ml-2">
                                                @example
                                            </MudText>
                                        </MudSelectItem>
                                    }
                                </MudSelect>

                                <MudSwitch T="bool" Value="_renameFiles" ValueChanged="OnRenameToggled"
                                           Color="Color.Warning" Label="Also rename the files inside" />

                                @if (_renameFiles)
                                {
                                    <MudTextField @bind-Value="_fileTemplate" Label="Name for each file"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                                  DebounceInterval="400" OnDebounceIntervalElapsed="Replan"
                                                  Error="@(_fileProblems.Count > 0)"
                                                  ErrorText="@string.Join(", ", _fileProblems)"
                                                  HelperText="The extension is always kept." />

                                    <MudSelect T="NameCase" Value="_fileCase" ValueChanged="OnFileCaseChanged"
                                               Label="File naming" Variant="Variant.Outlined" Margin="Margin.Dense"
                                               ToStringFunc="NameCasing.Label"
                                               HelperText="The extension keeps its own case either way.">
                                        @foreach (var (choice, label, example) in NameCasing.Choices)
                                        {
                                            <MudSelectItem T="NameCase" Value="@choice">
                                                @label
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary ml-2">
                                                    @example
                                                </MudText>
                                            </MudSelectItem>
                                        }
                                    </MudSelect>

                                    <MudAlert Severity="Severity.Warning" Dense="true">
                                        Original file names often carry the only record that a mesh is
                                        pre-supported, or is version two. Keep <code>{file}</code> in the
                                        template and that survives.
                                    </MudAlert>
                                }

                                <div>
                                    <MudText Typo="Typo.overline" Class="mud-text-secondary">Tokens</MudText>
                                    <div class="organize-tokens mt-2">
                                        @foreach (var token in PathTemplate.ModelTokens)
                                        {
                                            <code>@("{" + token.Name + "}")</code>
                                            <span>@token.Description</span>
                                        }
                                        @if (_renameFiles)
                                        {
                                            @foreach (var token in PathTemplate.FileTokens)
                                            {
                                                <code>@("{" + token.Name + "}")</code>
                                                <span>@token.Description</span>
                                            }
                                        }
                                    </div>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                                        An empty value falls back to a placeholder such as "Unsorted", so nothing
                                        ends up loose at the root.
                                    </MudText>
                                </div>
                            </MudStack>
                        </MudTabPanel>
                    </MudTabs>

                    @* Below a rule, because it is about the panel rather than
                       about whichever row it happens to land under. Sitting
                       flush at the end of a list of options, it read as a label
                       on the last one. *@
                    <MudDivider />

                    @* Names the saved layout rather than only saying whether
                       you match it. A row chip cannot answer this when what is
                       saved is a template of somebody's own -- there is no row
                       to put it on -- and "which scheme is this library
                       actually on" has to be answerable from either tab. *@
                    <div>
                        @if (SavedRules is null)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                                This library has no saved layout yet.
                            </MudText>
                        }
                        else
                        {
                            <div class="d-flex align-center gap-2 flex-wrap">
                                <MudIcon Icon="@Icons.Material.Filled.CloudDone" Size="Size.Small"
                                         Color="@(ConventionChanged ? Color.Default : Color.Success)" />
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    Saved for this library:
                                    <strong>@(_savedPreset?.Name ?? "a template of your own")</strong>
                                </MudText>
                            </div>

                            @* Spelled out when it is not a preset, because the
                               name alone does not identify it -- and from the
                               Presets tab it is the only sight of what picking
                               a preset would replace. *@
                            @if (_savedPreset is null)
                            {
                                <MudText Typo="Typo.caption"
                                         Class="organize-preset-example d-block ml-6">
                                    @SavedRules.FolderTemplate@(SavedRules.RenameFiles
                                        ? $"  ·  {SavedRules.FileTemplate}" : "")
                                </MudText>
                            }
                        }

                        @* Trying a layout out costs nothing; keeping one is a
                           button. Otherwise looking would overwrite. *@
                        @if (ConventionChanged)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                                @* There is no "that" to differ from until
                                   something has been saved. *@
                                @if (SavedRules is not null)
                                {
                                    <text>What is on screen differs from that.</text>
                                }
                                The plan on the right already uses the screen; saving only decides
                                what you come back to.
                            </MudText>
                            <div class="d-flex align-center gap-2 flex-wrap mt-2">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Save"
                                           Disabled="@(!CanSaveConvention)" OnClick="SaveConvention">
                                    Save for this library
                                </MudButton>
                                @if (SavedRules is not null)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text"
                                               OnClick="RevertConvention">
                                        Back to saved
                                    </MudButton>
                                }
                            </div>
                        }
                    </div>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="7" lg="8">
            @if (_plan is null)
            {
                <MudSkeleton Height="200px" />
            }
            else
            {
                <MudGrid Class="mb-4" Spacing="3">
                    <MudItem xs="6" sm="3">
                        <StatCard Value="@_plan.Moving.ToString("N0")" Label="Would move"
                                  Icon="@Icons.Material.Filled.DriveFileMove" />
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <StatCard Value="@_plan.AlreadyThere.ToString("N0")" Label="Already right"
                                  Icon="@Icons.Material.Filled.Check" />
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <StatCard Value="@_plan.Colliding.ToString("N0")" Label="Clashing"
                                  Icon="@Icons.Material.Filled.Warning" />
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        @* Deleting is the one thing here that cannot be undone,
                           so it gets the same prominence as the rest rather
                           than a footnote. *@
                        <StatCard Value="@_plan.Deletions.Count.ToString("N0")" Label="Would delete"
                                  Icon="@Icons.Material.Filled.DeleteForever" />
                    </MudItem>
                </MudGrid>

                @* A model with nothing for a token still files, quietly, into a
                   folder called Unsorted or Unfiled. That is almost never what
                   was meant, and it is invisible in a destination path that
                   reads like any other. *@
                @if (_plan.FallbackCounts.Count > 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                        <strong>Some models have nothing for part of the template</strong>
                        and would file under a placeholder:
                        <ul class="mt-2">
                            @foreach (var (token, count) in _plan.FallbackCounts)
                            {
                                <li>
                                    <MudText Typo="Typo.caption">
                                        <strong>@count</strong> with no <code>@token</code>
                                        &rarr; <code>@Placeholder(token)</code>
                                        @if (FilterFor(token) is { } filter)
                                        {
                                            <MudLink Href="@filter" Class="ml-2">find them</MudLink>
                                        }
                                    </MudText>
                                </li>
                            }
                        </ul>
                        Fill those in first and they will land where you meant, rather than in a
                        second tree you have to merge later.
                    </MudAlert>
                }

                @if (_plan.Deletions.Count > 0)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">
                        <strong>@_plan.Deletions.Count file(s) would be deleted.</strong>
                        Each one is a copy of a file going to the same place, and every copy is
                        read through and compared byte for byte before it goes &mdash; anything
                        that turns out to differ is left alone. They are marked in red below.
                    </MudAlert>
                }

                @if (_plan.Colliding > 0)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
                        @_plan.Colliding model(s) want a folder something else is already taking.
                        They would be skipped. Renaming them, or giving them different designers,
                        clears it.
                    </MudAlert>
                }

                <MudPaper Outlined="true">
                    <MudTable Items="_plan.Moves" Dense="true" Hover="true" Elevation="0"
                              Breakpoint="Breakpoint.Sm" RowsPerPage="25"
                              Filter="@(new Func<PlannedMove, bool>(Show))"
                              RowClassFunc="@((m, _) => SkipClass(m))">
                        <ToolBarContent>
                            <MudText Typo="Typo.subtitle2">Every model</MudText>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                     Class="ml-3 my-0">
                                @_chosen.Count of @_actionable.Count chosen
                            </MudChip>
                            <MudSpacer />
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ChooseAll"
                                       Disabled="@(_chosen.Count == _actionable.Count)">All</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ChooseNone"
                                       Disabled="@(_chosen.Count == 0)">None</MudButton>
                            <MudSwitch @bind-Value="_onlyChanges" Color="Color.Primary" T="bool"
                                       Label="Only what would change" />
                        </ToolBarContent>
                        <HeaderContent>
                            @* Selection is per model, not per row. A pack that
                               splits into ninety-eight folders shows ninety-eight
                               rows, and breaking it up halfway is not a thing
                               anyone means to ask for -- the decision is "this
                               model or not". *@
                            <MudTh Style="width:1px">
                                <MudCheckBox T="bool?" Value="@AllChosen" ValueChanged="ChooseAllToggled"
                                             Color="Color.Primary" Dense="true" TriState="true"
                                             Disabled="@(_actionable.Count == 0)" />
                            </MudTh>
                            <MudTh>Model</MudTh>
                            <MudTh>What happens</MudTh>
                            <MudTh>Now</MudTh>
                            <MudTh>Would become</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Include">
                                @* Nothing would happen to this row anyway, so a
                                   box that could be ticked would only promise
                                   something. *@
                                @if (_actionable.Contains(context.ModelId))
                                {
                                    <MudCheckBox T="bool" Dense="true" Color="Color.Primary"
                                                 Value="@_chosen.Contains(context.ModelId)"
                                                 ValueChanged="@(v => Choose(context.ModelId, v))" />
                                }
                            </MudTd>
                            <MudTd DataLabel="Model">
                                <MudLink Href="@($"/model/{context.ModelId}")">
                                    <MudText Typo="Typo.caption">@context.ModelName</MudText>
                                </MudLink>
                            </MudTd>

                            @* Deleting and skipping used to be announced only in
                               a panel at the foot of the page, nowhere near the
                               row it happened to. Anything that removes a file
                               belongs where the eye already is. *@
                            <MudTd DataLabel="What happens">
                                @{
                                    // Nothing moves off a row whose folder is
                                    // already right, however many files it
                                    // holds. "3 moved" beside "folder already
                                    // right" was counting the files it was
                                    // about to leave exactly where they are.
                                    var moving = context.Outcome == MoveOutcome.Move
                                        ? context.FileIds.Count
                                            - context.Deletions.Count - context.Conflicts.Count
                                        : 0;
                                }
                                <div class="d-flex flex-wrap gap-1">
                                    @* Only when something actually moves. "0 moved"
                                       beside a deletion reads as nothing happening
                                       to a row that is about to lose a file. *@
                                    @if (moving > 0)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                 Class="ma-0">@moving moved</MudChip>
                                    }
                                    @if (context.Renames.Count > 0)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                 Color="Color.Info" Class="ma-0">
                                            @context.Renames.Count renamed
                                        </MudChip>
                                    }
                                    @foreach (var deletion in context.Deletions)
                                    {
                                        <MudTooltip Text="@deletion.Reason">
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                                     Color="Color.Error" Class="ma-0"
                                                     Icon="@Icons.Material.Filled.DeleteForever">
                                                @System.IO.Path.GetFileName(deletion.Path) deleted
                                            </MudChip>
                                        </MudTooltip>
                                    }
                                    @foreach (var conflict in context.Conflicts)
                                    {
                                        <MudTooltip Text="@conflict.Reason">
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                                     Color="Color.Warning" Class="ma-0"
                                                     Icon="@Icons.Material.Filled.Block">
                                                @System.IO.Path.GetFileName(conflict.Path) stays
                                            </MudChip>
                                        </MudTooltip>
                                    }
                                </div>
                            </MudTd>
                            <MudTd DataLabel="Now">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary path-cell">
                                    @context.From
                                </MudText>
                            </MudTd>
                            <MudTd DataLabel="Would become">
                                @switch (context.Outcome)
                                {
                                    case MoveOutcome.AlreadyThere:
                                        @* "Already there" on its own used to be
                                           the whole answer, which was a lie the
                                           moment renaming was on: the folder is
                                           right and every file in it is still
                                           being renamed. *@
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            @(context.Renames.Count > 0
                                                ? "folder already right"
                                                : "— already there")
                                        </MudText>
                                        @if (!_chosen.Contains(context.ModelId)
                                             && _actionable.Contains(context.ModelId))
                                        {
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                                &mdash; not this run
                                            </MudText>
                                        }
                                        <RenamePreview Renames="context.Renames" />
                                        break;
                                    case MoveOutcome.Collides:
                                    case MoveOutcome.Unusable:
                                        <MudTooltip Text="@context.Problem">
                                            <MudText Typo="Typo.caption" Color="Color.Warning">
                                                skipped &mdash; @context.Problem
                                            </MudText>
                                        </MudTooltip>
                                        break;
                                    default:
                                        @* Where it would go stays visible even
                                           when it is not going. Replacing the
                                           path with "left alone" would hide the
                                           very thing being decided about. *@
                                        <MudText Typo="Typo.caption" Class="path-cell">@context.To</MudText>
                                        @if (!_chosen.Contains(context.ModelId)
                                             && _actionable.Contains(context.ModelId))
                                        {
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                                &mdash; not this run
                                            </MudText>
                                        }
                                        <RenamePreview Renames="context.Renames" />
                                        break;
                                }
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" />
                        </PagerContent>
                    </MudTable>
                </MudPaper>

                <MudPaper Outlined="true" Class="pa-4 mt-4">
                    @if (_library?.AllowOrganize != true)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            <strong>@_library?.Name</strong> is read-only, so nothing above can be
                            applied. Turn on "Allow MeshVault to move and rename files" in its
                            settings first.
                        </MudAlert>
                    }
                    else if (_plan.IsEmpty)
                    {
                        <MudAlert Severity="Severity.Success" Dense="true">
                            Everything is already where these rules want it.
                        </MudAlert>
                    }
                    else if (_chosen.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">
                            Nothing is ticked, so there is nothing to apply. Tick the models you want
                            moved, or press <strong>All</strong> above to take the whole plan.
                        </MudAlert>
                    }
                    else
                    {
                        @* Everything from here down describes the ticked models
                           rather than the whole plan. The counts above are what
                           the rules say about the library; these are what the
                           button does. *@
                        <MudText Typo="Typo.h6" Class="mb-2">Apply this plan</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                            Moves <strong>@Chosen.Moving</strong> folder(s) worth of files@(Chosen.Renames > 0
                                ? $", renames {Chosen.Renames} file(s)"
                                : "") inside
                            <code>@_library.Path</code>@(Chosen.Deletions.Count > 0
                                ? $" and deletes {Chosen.Deletions.Count} file(s) that would collide"
                                : "").
                            Files move; nothing is copied, and the catalog is rewritten to match as
                            it goes, so your tags and notes follow their models.
                            @if (_chosen.Count < _actionable.Count)
                            {
                                <text>
                                    The other @(_actionable.Count - _chosen.Count) model(s) in the
                                    table are left exactly as they are.
                                </text>
                            }
                        </MudText>

                        @* The planner allowed a destination because whatever sits
                           in it was moving out in the same run. Untick that one
                           and the folder is still occupied. Nothing is
                           overwritten -- the executor will not -- but the two end
                           up sharing a folder, which is not what either row
                           said. *@
                        @if (_needsVacating.Count > 0)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                                <strong>@_needsVacating.Count unticked model(s) are sitting in a folder
                                a ticked one wants.</strong> They were only free to use because this
                                plan moved that model out too. Tick them as well, or those files end
                                up sharing a folder.
                                <ul class="mt-2">
                                    @foreach (var blocker in _needsVacating.Take(20))
                                    {
                                        <li>
                                            <MudText Typo="Typo.caption">
                                                <strong>@blocker.ModelName</strong> still holds
                                                <code>@blocker.From</code>
                                            </MudText>
                                        </li>
                                    }
                                </ul>
                                <MudButton Size="Size.Small" Variant="Variant.Text" Class="mt-1"
                                           OnClick="ChooseBlockers">
                                    Tick those too
                                </MudButton>
                            </MudAlert>
                        }

                        @if (Chosen.Conflicts.Count > 0)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                                <strong>@Chosen.Conflicts.Count file(s) cannot be placed</strong> and will
                                stay where they are. Something different already claims the name each
                                would land under.
                                <MudExpansionPanels Elevation="0" Class="mt-2">
                                    <MudExpansionPanel Text="Show them">
                                        @foreach (var conflict in Chosen.Conflicts.Take(50))
                                        {
                                            <MudText Typo="Typo.caption" Class="d-block"
                                                     Style="font-family:ui-monospace,monospace">
                                                @conflict.Path
                                            </MudText>
                                            <MudText Typo="Typo.caption" Class="d-block mud-text-secondary mb-2">
                                                @conflict.Reason
                                            </MudText>
                                        }
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            </MudAlert>
                        }

                        @if (Chosen.Deletions.Count > 0)
                        {
                            <MudExpansionPanels Elevation="0" Class="mb-3">
                                <MudExpansionPanel Text="@($"{Chosen.Deletions.Count} file(s) will be deleted")">
                                    @foreach (var deletion in Chosen.Deletions.Take(50))
                                    {
                                        <MudText Typo="Typo.caption" Class="d-block mud-text-secondary"
                                                 Style="font-family:ui-monospace,monospace">
                                            @deletion.Path
                                        </MudText>
                                    }
                                    @if (Chosen.Deletions.Count > 50)
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            ...and @(Chosen.Deletions.Count - 50) more.
                                        </MudText>
                                    }
                                </MudExpansionPanel>
                            </MudExpansionPanels>
                        }

                        @if (_applying)
                        {
                            <div class="d-flex align-center gap-3 mb-2">
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                                <MudText Typo="Typo.body2">
                                    @(_progress is { Total: > 0 }
                                        ? $"{_progress.Done:N0} of {_progress.Total:N0} files"
                                        : "Starting...")
                                </MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary path-cell">
                                    @_progress?.Current
                                </MudText>
                            </div>

                            @if (_progress is { Total: > 0 })
                            {
                                <MudProgressLinear Color="Color.Warning"
                                                   Value="@(100.0 * _progress.Done / _progress.Total)" />
                            }

                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                                Running in the background. You can leave this page; it will keep going.
                            </MudText>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.DriveFileMove"
                                       Disabled="@Chosen.IsEmpty" OnClick="Apply">
                                @* The count is on the button on purpose. It is
                                   the last thing read before an irreversible
                                   run, and "Move the files" reads the same
                                   whether it means three models or three
                                   thousand. *@
                                @(_chosen.Count == _actionable.Count
                                    ? "Move the files"
                                    : $"Move {_chosen.Count} of {_actionable.Count} models")
                            </MudButton>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                                There is no undo. Back the library up first if you have not.
                            </MudText>
                        }
                    }

                    @if (_result is not null)
                    {
                        <MudAlert Severity="@(_result.Clean ? Severity.Success : Severity.Warning)"
                                  Dense="true" Class="mt-3">
                            @_result.FilesMoved file(s) moved into @_result.FoldersCreated new
                            folder(s). @_result.ModelsCreated model(s) added,
                            @_result.ModelsRemoved removed@(_result.FilesDeleted > 0
                                ? $", {_result.FilesDeleted} file(s) deleted" : "").
                            @if (!_result.Clean)
                            {
                                <ul class="mt-2">
                                    @foreach (var problem in _result.Problems.Take(20))
                                    {
                                        <li><MudText Typo="Typo.caption">@problem</MudText></li>
                                    }
                                </ul>
                                @if (_result.Problems.Count > 20)
                                {
                                    <MudText Typo="Typo.caption">
                                        ...and @(_result.Problems.Count - 20) more.
                                    </MudText>
                                }
                            }
                        </MudAlert>
                    }
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public int LibraryId { get; set; }

    private Library? _library;
    private OrganizePlan? _plan;
    /// <summary>Where a library with no convention of its own starts.</summary>
    private const string DefaultFolderTemplate = "{designer}/{model}";
    private const string DefaultFileTemplate = "{model} - {file}";

    private string _folderTemplate = DefaultFolderTemplate;
    private string _fileTemplate = DefaultFileTemplate;
    private bool _renameFiles;

    // AsWritten by default, which renders a template exactly as typed. That is
    // what every library had before there was a choice, and what the migration
    // left them holding.
    private NameCase _folderCase;
    private NameCase _fileCase;
    private bool _onlyChanges = true;
    private List<string> _folderProblems = [];
    private List<string> _fileProblems = [];

    // Applying runs on a background task rather than here. Several hundred file
    // moves is minutes of blocking filesystem calls, and doing that on the
    // circuit's own thread leaves this page unable to render the progress it is
    // being handed — it sits still and reads as finished while the share is
    // plainly still working.

    private bool _applying => Organizer.IsRunning(LibraryId);
    private OrganizeProgress? _progress => Organizer.GetStatus(LibraryId)?.Progress;
    private OrganizeResult? _result => Organizer.GetStatus(LibraryId)?.Result;
    private string? _applyMessage => Organizer.GetStatus(LibraryId)?.Message;

    private bool _wasRunning;

    // Which models the button will actually touch.
    //
    // Everything is ticked to begin with, so the page behaves as it always did
    // for anyone who just wants to run the whole plan; unticking is how you
    // narrow it. Keyed on the model rather than the row because a pack that
    // splits into ninety-eight destinations is still one decision -- half a
    // broken-up pack is not something anyone sets out to ask for.
    private readonly HashSet<int> _chosen = [];

    /// <summary>Models the plan would do something to, so worth a checkbox.</summary>
    private HashSet<int> _actionable = [];

    /// <summary>
    /// The plan narrowed to what is ticked. What Apply hands over, and what the
    /// panel under the table describes.
    /// </summary>
    /// <remarks>
    /// Held rather than recomputed on read: the apply panel asks it half a dozen
    /// times a render, its counts each walk every move, and a render happens on
    /// every tick of a box.
    /// </remarks>
    private OrganizePlan Chosen { get; set; } = new([]);

    /// <summary>Unticked models whose folder a ticked one is being sent into.</summary>
    private IReadOnlyList<PlannedMove> _needsVacating = [];

    /// <summary>Header checkbox: on, off, or partway.</summary>
    private bool? AllChosen =>
        _chosen.Count == 0 ? false
        : _chosen.Count == _actionable.Count ? true
        : null;

    private void Apply()
    {
        if (_plan is null || _library is null) return;

        // The narrowed plan, not the whole one. Narrowing only ever drops rows,
        // so every move that runs is one that was on screen.
        var plan = Chosen;
        if (plan.IsEmpty) return;

        if (!Organizer.TryStart(LibraryId, plan))
            Snackbar.Add("Already organizing this library.", Severity.Info);
    }

    private void Choose(int modelId, bool wanted)
    {
        if (wanted) _chosen.Add(modelId); else _chosen.Remove(modelId);
        OnChoiceChanged();
    }

    private void ChooseAll()
    {
        _chosen.UnionWith(_actionable);
        OnChoiceChanged();
    }

    private void ChooseNone()
    {
        _chosen.Clear();
        OnChoiceChanged();
    }

    /// <summary>
    /// Tri-state header box. Partway counts as "not all", so the next click
    /// fills the rest in rather than throwing the selection away.
    /// </summary>
    private void ChooseAllToggled(bool? value)
    {
        if (value is true or null) ChooseAll(); else ChooseNone();
    }

    private void ChooseBlockers()
    {
        foreach (var blocker in _needsVacating) _chosen.Add(blocker.ModelId);
        OnChoiceChanged();
    }

    /// <summary>Redoes everything that hangs off the ticks. Called whenever they change.</summary>
    private void OnChoiceChanged()
    {
        Chosen = (_plan ?? new OrganizePlan([])).For(_chosen);
        _needsVacating = _plan?.VacancyNeeded(_chosen) ?? [];
    }

    /// <summary>Dims a row the plan describes but this run will not touch.</summary>
    private string SkipClass(PlannedMove move) =>
        _actionable.Contains(move.ModelId) && !_chosen.Contains(move.ModelId)
            ? "organize-skipped"
            : "";

    /// <summary>
    /// Re-renders on every status change, and replans once the run finishes:
    /// every path in the old plan has just changed, so leaving it up would
    /// describe a library that no longer exists.
    /// </summary>
    private void OnOrganizeChanged() => InvokeAsync(async () =>
    {
        var running = Organizer.IsRunning(LibraryId);
        var finished = _wasRunning && !running;
        _wasRunning = running;

        if (finished) await Replan();
        StateHasChanged();
    });

    protected override async Task OnInitializedAsync()
    {
        Organizer.Changed += OnOrganizeChanged;
        _wasRunning = Organizer.IsRunning(LibraryId);
        _library = (await Catalog.GetLibrariesAsync()).FirstOrDefault(l => l.Id == LibraryId);

        // Whatever was settled on last time, rather than the built-in defaults.
        if (_library is not null)
        {
            _folderTemplate = _library.FolderTemplate ?? _folderTemplate;
            _fileTemplate = _library.FileTemplate ?? _fileTemplate;
            _renameFiles = _library.RenameFiles;
            _folderCase = _library.FolderCase;
            _fileCase = _library.FileCase;

            // Opened on whichever tab describes what this library already does.
            // Someone who settled on a template of their own should not have to
            // find it again on every visit.
            _tab = _preset is null ? CustomTab : PresetsTab;

            await Replan();
        }
    }

    public void Dispose() => Organizer.Changed -= OnOrganizeChanged;

    private async Task OnRenameToggled(bool value)
    {
        _renameFiles = value;
        await Replan();
    }

    /// <summary>
    /// The preset the controls currently add up to, or null for a template of
    /// somebody's own.
    /// </summary>
    /// <remarks>
    /// Derived rather than stored. Editing a template by hand until it matches
    /// a preset again should select that preset, and a remembered answer would
    /// disagree with the fields sitting right under it.
    /// </remarks>
    private OrganizePreset? _preset => OrganizePresets.Matching(CurrentRules);

    /// <summary>
    /// What this library has stored, or null while it has never been organized.
    /// </summary>
    private OrganizeRules? SavedRules => _library?.FolderTemplate is null ? null : new OrganizeRules
    {
        FolderTemplate = _library.FolderTemplate,
        FileTemplate = _library.FileTemplate ?? DefaultFileTemplate,
        RenameFiles = _library.RenameFiles,
        FolderCase = _library.FolderCase,
        FileCase = _library.FileCase,
    };

    /// <summary>
    /// The preset this library has saved, marked in the list so "which one is
    /// this library actually on" is answered on the row rather than underneath
    /// all of them. Null when what is saved is a template of somebody's own.
    /// </summary>
    private OrganizePreset? _savedPreset =>
        SavedRules is { } saved ? OrganizePresets.Matching(saved) : null;

    // Which of the two the page is showing. Deliberately not derived from
    // whether a preset matches: switching to Custom to read a template, then
    // deciding to leave it alone, must not throw you back to Presets. The tab
    // is where you are, not what your rules are.
    private int _tab;
    private const int PresetsTab = 0;
    private const int CustomTab = 1;

    private async Task ApplyPreset(string? name)
    {
        if (OrganizePresets.All.FirstOrDefault(p => p.Name == name) is not { } preset) return;

        _folderTemplate = preset.Rules.FolderTemplate;
        _folderCase = preset.Rules.FolderCase;
        _renameFiles = preset.Rules.RenameFiles;

        // Only when the preset renames. Otherwise picking "By designer" would
        // quietly reset a file template somebody had settled on, and switching
        // back would not bring it back.
        if (preset.Rules.RenameFiles)
        {
            _fileTemplate = preset.Rules.FileTemplate;
            _fileCase = preset.Rules.FileCase;
        }

        await Replan();
    }

    /// <summary>What is on screen, as the planner and the editor both want it.</summary>
    private OrganizeRules CurrentRules => new()
    {
        FolderTemplate = _folderTemplate,
        FileTemplate = _fileTemplate,
        RenameFiles = _renameFiles,
        FolderCase = _folderCase,

        // Only meaningful when renaming is on, and deliberately not zeroed when
        // it is off: turning the switch back on should find the choice where it
        // was left rather than reset to "leave as written".
        FileCase = _fileCase,
    };

    private async Task OnFolderCaseChanged(NameCase value)
    {
        _folderCase = value;
        await Replan();
    }

    private async Task OnFileCaseChanged(NameCase value)
    {
        _fileCase = value;
        await Replan();
    }

    private async Task Replan()
    {
        // Unknown tokens are named rather than silently rendering as nothing,
        // which would otherwise look like a template that simply did not work.
        _folderProblems = PathTemplate.UnknownTokens(_folderTemplate, forFile: false)
            .Select(t => $"There is no {{{t}}} token")
            .ToList();

        _fileProblems = _renameFiles
            ? PathTemplate.UnknownTokens(_fileTemplate, forFile: true)
                .Select(t => $"There is no {{{t}}} token")
                .ToList()
            : [];

        var rules = CurrentRules;

        // Whether the whole plan was taken before this replan, so that stays
        // true across a template tweak. Anyone who narrowed it down keeps their
        // ticks instead, minus models the new plan has nothing to do to.
        var wasEverything = _plan is null || _chosen.Count == _actionable.Count;

        _plan = await Planner.PlanAsync(LibraryId, rules);

        _actionable = [.. _plan.ActionableModelIds];

        if (wasEverything)
        {
            _chosen.Clear();
            _chosen.UnionWith(_actionable);
        }
        else
        {
            _chosen.IntersectWith(_actionable);
        }

        OnChoiceChanged();
    }

    /// <summary>
    /// Whether what is on screen differs from what this library has settled on.
    /// </summary>
    /// <remarks>
    /// Saving is deliberate rather than automatic. Trying a template to see what
    /// it would do is the main thing this page is for, and a preview that
    /// quietly overwrote the convention — with no undo — would make exploring
    /// it cost something.
    /// </remarks>
    private bool ConventionChanged =>
        _folderTemplate != (_library?.FolderTemplate ?? "")
        || (_renameFiles && _fileTemplate != (_library?.FileTemplate ?? ""))
        || _renameFiles != (_library?.RenameFiles ?? false)
        || _folderCase != (_library?.FolderCase ?? NameCase.AsWritten)
        || (_renameFiles && _fileCase != (_library?.FileCase ?? NameCase.AsWritten));

    private bool CanSaveConvention =>
        ConventionChanged
        && _folderProblems.Count == 0
        && _fileProblems.Count == 0
        && !string.IsNullOrWhiteSpace(_folderTemplate);

    private async Task SaveConvention()
    {
        var rules = CurrentRules;

        await Editor.SetOrganizeRulesAsync(LibraryId, rules);

        // Refreshed rather than assumed, so the button goes quiet only because
        // the stored value really did change.
        _library = (await Catalog.GetLibrariesAsync()).FirstOrDefault(l => l.Id == LibraryId);
        Snackbar.Add("Saved as this library's naming convention", Severity.Success);
    }

    private async Task RevertConvention()
    {
        _folderTemplate = _library?.FolderTemplate ?? DefaultFolderTemplate;
        _fileTemplate = _library?.FileTemplate ?? DefaultFileTemplate;
        _renameFiles = _library?.RenameFiles ?? false;
        _folderCase = _library?.FolderCase ?? NameCase.AsWritten;
        _fileCase = _library?.FileCase ?? NameCase.AsWritten;
        await Replan();
    }

    /// <summary>The folder name a token falls back to when a model has nothing for it.</summary>
    private static string Placeholder(string token) =>
        PathTemplate.ModelTokens.FirstOrDefault(t =>
            string.Equals(t.Name, token, StringComparison.OrdinalIgnoreCase))?.Fallback ?? "";

    /// <summary>
    /// Where to go and fill the gap in, for the tokens Browse can filter on.
    /// </summary>
    /// <remarks>
    /// Saying that twelve models have no collection is only half a sentence
    /// without a way to reach those twelve. Tokens with no filter behind them
    /// simply get no link rather than a dead one.
    /// </remarks>
    private string? FilterFor(string token) => token.ToLowerInvariant() switch
    {
        "designer" => $"/browse?libraryId={LibraryId}&missingDesigner=true",
        "collection" => $"/browse?libraryId={LibraryId}&missingCollection=true",
        "source" => $"/browse?libraryId={LibraryId}&missingSource=true",
        _ => null,
    };

    /// <summary>
    /// A row worth reading. Deletions and conflicts count as changes even on a
    /// model that is otherwise staying put — hiding the row that removes a file
    /// is exactly how a deletion goes unnoticed.
    /// </summary>
    private bool Show(PlannedMove move) =>
        !_onlyChanges
        || move.Outcome != MoveOutcome.AlreadyThere
        || move.Renames.Count > 0
        || move.Deletions.Count > 0
        || move.Conflicts.Count > 0;
}
