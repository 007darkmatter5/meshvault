@page "/"
@page "/browse"
@attribute [Authorize(Policy = Policies.View)]
@rendermode InteractiveServer
@implements IDisposable
@inject ModelCatalog Catalog
@inject ModelEditor Editor
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>MeshVault</PageTitle>

<MudGrid Spacing="4">
    <MudItem xs="12" md="3" lg="2">
        <MudPaper Outlined="true" Class="pa-4">
            <MudStack Spacing="4">
                <MudSelect T="int?" Value="_libraryId" ValueChanged="@(v => Apply(() => _libraryId = v))"
                           Label="Library" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                    <MudSelectItem T="int?" Value="@(null)">All libraries</MudSelectItem>
                    @foreach (var library in _libraries)
                    {
                        <MudSelectItem T="int?" Value="@library.Id">@library.Name</MudSelectItem>
                    }
                </MudSelect>

                @if (_designers.Count > 0)
                {
                    <MudSelect T="int?" Value="_designerId" ValueChanged="@(v => Apply(() => _designerId = v))"
                               Label="Designer" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                        <MudSelectItem T="int?" Value="@(null)">Any designer</MudSelectItem>
                        @foreach (var entry in _designers)
                        {
                            <MudSelectItem T="int?" Value="@entry.Designer.Id">
                                @entry.Designer.Name (@entry.Count)
                            </MudSelectItem>
                        }
                    </MudSelect>
                }

                @if (_collections.Count > 0)
                {
                    <MudSelect T="int?" Value="_collectionId" ValueChanged="@(v => Apply(() => _collectionId = v))"
                               Label="Collection" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                        <MudSelectItem T="int?" Value="@(null)">Any collection</MudSelectItem>
                        @foreach (var entry in _collections)
                        {
                            <MudSelectItem T="int?" Value="@entry.Collection.Id">
                                @entry.Collection.Name (@entry.Count)
                            </MudSelectItem>
                        }
                    </MudSelect>
                }

                @if (_sites.Count > 0)
                {
                    <MudSelect T="string" Value="_site" ValueChanged="@(v => Apply(() => _site = v))"
                               Label="Source" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                        <MudSelectItem T="string" Value="@(null)">Any source</MudSelectItem>
                        @foreach (var entry in _sites)
                        {
                            <MudSelectItem T="string" Value="@entry.Site">@entry.Site (@entry.Count)</MudSelectItem>
                        }
                    </MudSelect>
                }

                <MudSelect T="ModelSort" Value="_sort" ValueChanged="@(v => Apply(() => _sort = v))"
                           Label="Sort" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="ModelSort" Value="ModelSort.Name">Name</MudSelectItem>
                    <MudSelectItem T="ModelSort" Value="ModelSort.Newest">Recently added</MudSelectItem>
                    <MudSelectItem T="ModelSort" Value="ModelSort.Largest">Largest</MudSelectItem>
                </MudSelect>

                <MudStack Spacing="1">
                    @if (_canEdit)
                    {
                        <MudSwitch T="bool" Value="_favoritesOnly" ValueChanged="@(v => Apply(() => _favoritesOnly = v))"
                                   Color="Color.Warning" Label="Favorites only" />
                    }
                    <MudSwitch T="bool" Value="_missingDesigner" ValueChanged="@(v => Apply(() => _missingDesigner = v))"
                               Color="Color.Info" Label="No designer set" />
                    <MudSwitch T="bool" Value="_missingSource" ValueChanged="@(v => Apply(() => _missingSource = v))"
                               Color="Color.Info" Label="No source link" />
                    <MudSwitch T="bool" Value="_missingCollection" ValueChanged="@(v => Apply(() => _missingCollection = v))"
                               Color="Color.Info" Label="Not in a collection" />
                    <MudSwitch T="bool" Value="_unfiledOnly" ValueChanged="@(v => Apply(() => _unfiledOnly = v))"
                               Color="Color.Warning" Label="Unfiled: still in the inbox" />
                </MudStack>

                @if (_tagCounts.Count > 0)
                {
                    <div>
                        <MudText Typo="Typo.overline" Class="mud-text-secondary">Tags</MudText>
                        <div class="d-flex flex-wrap gap-1 mt-2">
                            @foreach (var entry in _tagCounts)
                            {
                                var normalized = entry.Tag.NormalizedName;
                                var active = _selectedTags.Contains(normalized);
                                <MudChip T="string" Size="Size.Small" Class="ma-0"
                                         Color="@(active ? Color.Primary : Color.Default)"
                                         Variant="@(active ? Variant.Filled : Variant.Outlined)"
                                         OnClick="@(() => ToggleTag(normalized))">
                                    @entry.Tag.Name (@entry.Count)
                                </MudChip>
                            }
                        </div>
                    </div>
                }

                @if (HasFilters)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.FilterAltOff"
                               OnClick="ClearFilters">Clear filters</MudButton>
                }
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="9" lg="10">
        <div class="d-flex align-center gap-4 mb-4">
            <MudTextField T="string" Value="_search" ValueChanged="@(v => Apply(() => _search = v ?? ""))"
                          Immediate="true" DebounceInterval="250" Placeholder="Search models, designers..."
                          Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="max-width:420px" />
            @if (_result is not null)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @_result.TotalCount.ToString("N0") @(_result.TotalCount == 1 ? "model" : "models")
                </MudText>
            }
            @if (_loading)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
            }

            <MudSpacer />

            @if (_canEdit)
            {
                <MudButton Size="Size.Small" Variant="@(_selecting ? Variant.Filled : Variant.Outlined)"
                           Color="@(_selecting ? Color.Primary : Color.Default)"
                           StartIcon="@Icons.Material.Filled.Checklist"
                           OnClick="ToggleSelecting">
                    @(_selecting ? "Done" : "Select")
                </MudButton>
            }
        </div>

        @* The selection survives paging and filtering, so this bar has to say
           how many are held rather than how many are on screen. *@
        @if (_selecting)
        {
            <MudPaper Outlined="true" Class="pa-3 mb-4 d-flex align-center flex-wrap gap-2">
                <MudText Typo="Typo.body2" Style="font-weight:600">
                    @_selected.Count selected
                </MudText>

                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="SelectPage"
                           Disabled="@(_result is null || _result.Items.Count == 0)">
                    Select this page
                </MudButton>

                @if (_result is { TotalCount: > 0 } result && result.TotalCount > result.Items.Count)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="SelectAllMatching">
                        Select all @result.TotalCount.ToString("N0") matching
                    </MudButton>
                }

                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearSelection"
                           Disabled="@(_selected.Count == 0)">
                    Clear
                </MudButton>

                <MudSpacer />

                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Edit"
                           Disabled="@(_selected.Count == 0)" OnClick="OpenBulkEdit">
                    Edit @_selected.Count
                </MudButton>
            </MudPaper>
        }

        @if (_result is null)
        {
            <MudSkeleton Height="200px" />
        }
        else if (_result.Items.Count == 0)
        {
            <MudPaper Outlined="true" Class="pa-12 d-flex flex-column align-center gap-3">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Class="mud-text-secondary" />
                <MudText Typo="Typo.h6">Nothing here yet</MudText>
                @if (_libraries.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        No libraries are configured. Add the folder your models live in to get started.
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/libraries"
                               StartIcon="@Icons.Material.Filled.Add">Add a library</MudButton>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        No models match the current filters.
                    </MudText>
                }
            </MudPaper>
        }
        else
        {
            <div class="model-grid">
                @foreach (var card in _result.Items)
                {
                    var model = card.Model;
                    <MudCard Outlined="true" @key="model.Id"
                             Class="@($"model-card{(_selected.Contains(model.Id) ? " model-card-selected" : "")}")">
                        @if (_selecting)
                        {
                            @* Outside the anchor, so ticking a box cannot also
                               navigate to the model. *@
                            <div class="model-select">
                                <MudCheckBox T="bool" Value="_selected.Contains(model.Id)" Dense="true"
                                             Color="Color.Primary"
                                             ValueChanged="@((bool on) => SetSelected(model.Id, on))" />
                            </div>
                        }
                        @* A real anchor rather than a click handler, so middle-click
                           and "open in new tab" behave as expected. *@
                        <a class="model-card-link" href="@($"/model/{model.Id}")">
                            <div class="model-thumb">
                                @if (HasImage(model))
                                {
                                    @* loading="lazy" matters: a page of 60 cards would
                                       otherwise fire 60 requests at once. *@
                                    <img class="model-thumb-img" loading="lazy" decoding="async"
                                         src="@ThumbUrl(model)" alt="@model.Name" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.ViewInAr" Size="Size.Large" />
                                }
                                <span class="model-thumb-count">@MeshCount(model)</span>
                            </div>
                            <MudCardContent Class="pa-3">
                                <div class="d-flex align-center justify-space-between gap-1">
                                    <MudText Typo="Typo.body2" Class="model-title" title="@model.RelativePath">
                                        @model.Name
                                    </MudText>
                                    @if (card.IsFavorite && _canEdit)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Size="Size.Small" />
                                    }
                                </div>
                                @if (model.Designer is not null)
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block model-title">
                                        by @model.Designer.Name
                                    </MudText>
                                }
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @Formats.Bytes(model.TotalBytes) &middot;
                                    @model.Files.Count @(model.Files.Count == 1 ? "file" : "files")
                                </MudText>
                                <div class="d-flex flex-wrap gap-1 mt-2">
                                    @if (Inbox.Holds(model.Library?.InboxPath, model.RelativePath))
                                    {
                                        <MudTooltip Text="Still in the inbox. Give it a designer, then organize it.">
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                                     Color="Color.Warning" Class="ma-0">Unfiled</MudChip>
                                        </MudTooltip>
                                    }
                                    @if (model.SourceSite is not null)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                                 Color="Color.Dark" Class="ma-0">@model.SourceSite</MudChip>
                                    }
                                    @foreach (var tag in model.Tags.Take(2))
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ma-0">
                                            @tag.Name
                                        </MudChip>
                                    }
                                </div>
                            </MudCardContent>
                        </a>
                    </MudCard>
                }
            </div>

            @if (_result.TotalPages > 1)
            {
                <div class="d-flex justify-center mt-6">
                    <MudPagination Count="_result.TotalPages" Selected="_page" SelectedChanged="GoToPage"
                                   Color="Color.Primary" Rectangular="true" />
                </div>
            }
        }
    </MudItem>
</MudGrid>

@code {
    // Every filter lives in the query string, and the address bar is the only
    // record of what is selected.
    //
    // Held in fields alone they lasted until you looked at a model and came
    // back, because arriving here rebuilds them from the URL and whatever was
    // not written there was gone. Keeping them here instead means the browser's
    // own Back works, a reload keeps its place, and a filtered view is a link
    // somebody can send.
    [SupplyParameterFromQuery] public int? DesignerId { get; set; }
    [SupplyParameterFromQuery] public int? CollectionId { get; set; }
    [SupplyParameterFromQuery] public bool? MissingDesigner { get; set; }
    [SupplyParameterFromQuery] public bool? MissingSource { get; set; }
    [SupplyParameterFromQuery] public bool? MissingCollection { get; set; }
    [SupplyParameterFromQuery] public int? LibraryId { get; set; }
    [SupplyParameterFromQuery] public bool? Unfiled { get; set; }
    [SupplyParameterFromQuery] public string? Site { get; set; }
    [SupplyParameterFromQuery] public bool? Favorites { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }
    [SupplyParameterFromQuery] public string? Tags { get; set; }
    [SupplyParameterFromQuery] public string? Sort { get; set; }
    [SupplyParameterFromQuery] public int? Page { get; set; }

    private List<Library> _libraries = [];
    private List<(Tag Tag, int Count)> _tagCounts = [];
    private List<(Designer Designer, int Count)> _designers = [];
    private List<(Collection Collection, int Count)> _collections = [];
    private List<(string Site, int Count)> _sites = [];
    private PagedResult<ModelCard>? _result;
    private readonly HashSet<string> _selectedTags = [];

    private string _search = "";
    private int? _libraryId;
    private int? _designerId;
    private int? _collectionId;
    private string? _site;
    private ModelSort _sort = ModelSort.Name;
    private bool _favoritesOnly;
    private bool _missingDesigner;
    private bool _missingSource;
    private bool _missingCollection;
    private bool _unfiledOnly;
    private int _page = 1;
    private bool _loading;

    // Guards against a slow earlier query overwriting a newer one's results.
    private CancellationTokenSource? _inFlight;

    private bool HasFilters =>
        !string.IsNullOrEmpty(_search) || _libraryId is not null || _designerId is not null
        || _collectionId is not null || _site is not null || _favoritesOnly
        || _missingDesigner || _missingSource || _missingCollection || _unfiledOnly
        || _selectedTags.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _canEdit = state.User.Identity?.IsAuthenticated ?? false;
        await LoadFacetsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // The URL says what is selected, so reading it back is the whole of it.
        // Because Apply writes exactly what these fields hold, the round trip is
        // a no-op and nothing is lost on the way through.
        _designerId = DesignerId;
        _collectionId = CollectionId;
        _missingDesigner = MissingDesigner ?? false;
        _missingSource = MissingSource ?? false;
        _missingCollection = MissingCollection ?? false;
        _libraryId = LibraryId;
        _unfiledOnly = Unfiled ?? false;
        _favoritesOnly = Favorites ?? false;
        _site = Site;
        _search = Query ?? "";
        _sort = Enum.TryParse<ModelSort>(Sort, ignoreCase: true, out var sort) ? sort : ModelSort.Name;
        _page = Math.Max(1, Page ?? 1);

        _selectedTags.Clear();
        foreach (var tag in (Tags ?? "")
                     .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
            _selectedTags.Add(tag);

        await LoadAsync();
    }

    /// <summary>
    /// This page's address with everything currently selected written into it.
    /// </summary>
    /// <remarks>
    /// A filter at its default is left out rather than spelled as its default,
    /// so an unfiltered Browse is a clean "/browse" and a link carries only what
    /// somebody actually chose.
    /// </remarks>
    private string FilterUri() => Nav.GetUriWithQueryParameters(
        Nav.ToAbsoluteUri("/browse").ToString(),
        new Dictionary<string, object?>
        {
            ["q"] = string.IsNullOrWhiteSpace(_search) ? null : _search,
            ["libraryId"] = _libraryId,
            ["designerId"] = _designerId,
            ["collectionId"] = _collectionId,
            ["site"] = _site,
            ["tags"] = _selectedTags.Count == 0 ? null : string.Join(',', _selectedTags),
            ["favorites"] = _favoritesOnly ? true : null,
            ["missingDesigner"] = _missingDesigner ? true : null,
            ["missingSource"] = _missingSource ? true : null,
            ["missingCollection"] = _missingCollection ? true : null,
            ["unfiled"] = _unfiledOnly ? true : null,
            ["sort"] = _sort == ModelSort.Name ? null : _sort.ToString(),
            ["page"] = _page > 1 ? _page : null,
        });

    // Selecting and bulk editing ---------------------------------------------

    /// <summary>
    /// False for a signed-out visitor. Selecting models leads only to a bulk
    /// edit, and favorites belong to an account.
    /// </summary>
    private bool _canEdit;

    private bool _selecting;

    /// <summary>
    /// Held across paging and filtering, so a selection can be gathered from
    /// several searches before anything is applied to it. Ids rather than cards,
    /// because a card off screen has been thrown away.
    /// </summary>
    private readonly HashSet<int> _selected = [];

    private ModelQuery CurrentQuery() => new()
    {
        Search = _search,
        LibraryId = _libraryId,
        DesignerId = _designerId,
        CollectionId = _collectionId,
        SourceSite = _site,
        Tags = _selectedTags.ToList(),
        FavoritesOnly = _favoritesOnly,
        MissingDesigner = _missingDesigner,
        MissingSource = _missingSource,
        MissingCollection = _missingCollection,
        UnfiledOnly = _unfiledOnly,
        Sort = _sort,
        Page = _page,
    };

    private void ToggleSelecting()
    {
        _selecting = !_selecting;

        // Leaving selection mode drops the selection. Keeping it invisibly
        // would mean a later edit hitting models chosen and forgotten.
        if (!_selecting) _selected.Clear();
    }

    private void SetSelected(int modelId, bool selected)
    {
        if (selected) _selected.Add(modelId);
        else _selected.Remove(modelId);
    }

    private void SelectPage()
    {
        if (_result is null) return;
        foreach (var card in _result.Items) _selected.Add(card.Model.Id);
    }

    private async Task SelectAllMatching()
    {
        // Asks the database rather than walking every page, so "tag all 400
        // models by this designer" is one action instead of seven.
        foreach (var id in await Catalog.GetMatchingIdsAsync(CurrentQuery())) _selected.Add(id);

        Snackbar.Add($"{_selected.Count:N0} selected", Severity.Info);
    }

    private void ClearSelection() => _selected.Clear();

    private async Task OpenBulkEdit()
    {
        if (_selected.Count == 0) return;

        var parameters = new DialogParameters<BulkEditDialog>
        {
            { x => x.ModelIds, _selected.ToList() },
            { x => x.Collections, _collections.Select(c => c.Collection).ToList() },
        };

        var dialog = await Dialogs.ShowAsync<BulkEditDialog>("Edit models", parameters);
        if ((await dialog.Result) is not { Canceled: false, Data: BulkEditResult result }) return;

        Snackbar.Add(Describe(result), result.ChangedNothing ? Severity.Info : Severity.Success);

        // Facet counts and the cards themselves both moved.
        await LoadFacetsAsync();
        await LoadAsync();
    }

    /// <summary>
    /// Says what actually changed rather than "done". A bulk edit that quietly
    /// did nothing - every model already had that tag, say - is worth knowing
    /// about, and the counts are the only way to tell.
    /// </summary>
    private static string Describe(BulkEditResult result)
    {
        if (result.ChangedNothing) return "Nothing to change; they were already like that.";

        var parts = new List<string>();
        if (result.DesignerChanged > 0) parts.Add($"designer on {result.DesignerChanged:N0}");
        if (result.TagsAdded > 0) parts.Add($"{result.TagsAdded:N0} tag(s) added");
        if (result.TagsRemoved > 0) parts.Add($"{result.TagsRemoved:N0} tag(s) removed");
        if (result.CollectionChanged > 0) parts.Add($"collection on {result.CollectionChanged:N0}");
        if (result.FavoritesChanged > 0) parts.Add($"{result.FavoritesChanged:N0} favorite(s)");

        return $"Updated {result.Models:N0} model(s): {string.Join(", ", parts)}.";
    }

    private async Task LoadFacetsAsync()
    {
        _libraries = await Catalog.GetLibrariesAsync();
        _tagCounts = await Catalog.GetTagCountsAsync();
        _designers = await Catalog.GetDesignersAsync();
        _collections = await Catalog.GetCollectionsAsync();
        _sites = await Catalog.GetSourceSitesAsync();
    }

    private static int MeshCount(ModelEntry model) => model.Files.Count(f => f.Kind == FileKind.Mesh);

    private static bool HasImage(ModelEntry model) =>
        model.SnapshotUpdatedUtc is not null || model.ThumbnailFileId is not null;

    /// <summary>
    /// The snapshot timestamp is part of the URL so that replacing a card image
    /// is visible immediately rather than after the browser cache expires.
    /// </summary>
    private static string ThumbUrl(ModelEntry model) =>
        model.SnapshotUpdatedUtc is { } stamp
            ? $"/thumb/model/{model.Id}?v={stamp.ToUnixTimeSeconds()}"
            : $"/thumb/model/{model.Id}";

    private async Task LoadAsync()
    {
        _inFlight?.Cancel();
        _inFlight?.Dispose();
        _inFlight = new CancellationTokenSource();
        var token = _inFlight.Token;

        _loading = true;
        try
        {
            var result = await Catalog.SearchAsync(CurrentQuery(), token);

            if (token.IsCancellationRequested) return;
            _result = result;
            _loading = false;
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer query; the newer one owns the loading flag.
        }
    }

    /// <summary>Applies a filter change and resets to the first page.</summary>
    /// <summary>
    /// Changes a filter and puts the result in the address bar, which is what
    /// then loads it. Replaces rather than pushes: typing six letters into the
    /// search box should not be six presses of Back to undo.
    /// </summary>
    private Task Apply(Action change)
    {
        change();
        _page = 1;
        Nav.NavigateTo(FilterUri(), replace: true);
        return Task.CompletedTask;
    }

    private Task ToggleTag(string normalized) => Apply(() =>
    {
        if (!_selectedTags.Remove(normalized)) _selectedTags.Add(normalized);
    });

    private Task ClearFilters() => Apply(() =>
    {
        _search = "";
        _libraryId = _designerId = _collectionId = null;
        _site = null;
        _favoritesOnly = _missingDesigner = _missingSource = _missingCollection = _unfiledOnly = false;
        _selectedTags.Clear();
    });

    /// <summary>
    /// Paging does push a history entry: moving to page four is a place you
    /// might reasonably want Back to return you from.
    /// </summary>
    private void GoToPage(int page)
    {
        _page = Math.Max(1, page);
        Nav.NavigateTo(FilterUri());
    }

    public void Dispose()
    {
        _inFlight?.Cancel();
        _inFlight?.Dispose();
    }
}
