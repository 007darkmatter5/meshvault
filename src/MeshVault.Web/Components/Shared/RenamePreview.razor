@*
    What the files inside a model would end up called.

    A count on its own ("6 renamed") says something is about to happen without
    saying what, which is the one thing a plan is for. It matters more now that
    a casing convention can rewrite every name in the library at once: the whole
    reason to pick kebab-case is to see what kebab-case does to your files.
*@

@if (Renames.Count > 0)
{
    <div class="organize-renames mt-1">
        @foreach (var rename in Renames.Take(Limit))
        {
            <span class="rename-from">@rename.From</span>
            <span class="rename-arrow">&rarr;</span>
            <span class="rename-to">@rename.To</span>
        }
    </div>

    @* Every name in a ninety-eight-file pack would bury the row it belongs to.
       A few is enough to see the shape of the rule; the exact list is the
       file table on the model itself. *@
    @if (Renames.Count > Limit)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            ...and @(Renames.Count - Limit) more renamed the same way.
        </MudText>
    }
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PlannedRename> Renames { get; set; } = [];

    /// <summary>How many to spell out before summarising the rest.</summary>
    [Parameter] public int Limit { get; set; } = 3;
}
