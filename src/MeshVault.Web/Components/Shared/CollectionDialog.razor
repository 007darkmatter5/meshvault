@inject ModelEditor Editor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(CollectionId is null ? "New collection" : "Edit collection")</MudText>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Immediate="true" AutoFocus="true" OnKeyDown="OnKeyDown"
                          Error="@string.IsNullOrWhiteSpace(Name)" ErrorText="A name is required" />
            <MudTextField @bind-Value="Description" Label="Description" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Lines="2" Placeholder="Optional" />
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@string.IsNullOrWhiteSpace(Name)" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter] public int? CollectionId { get; set; }
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";

    private string? _error;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(Name)) await Save();
    }

    private async Task Save()
    {
        _error = null;
        try
        {
            if (CollectionId is { } id)
                await Editor.RenameCollectionAsync(id, Name, Description);
            else
                await Editor.CreateCollectionAsync(Name, Description);

            Dialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            // Most often a duplicate name, which the user can fix in place.
            _error = ex.Message;
        }
    }
}
