@inherits LayoutComponentBase
@inject SettingsStore Settings

@* Statically rendered on purpose. Pages opt into interactivity individually,
   which lets the sign-in pages stay static so their form posts can be mapped
   and so signing in can actually write a cookie. *@

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Color="Color.Surface">
        <MudLink Href="/" Underline="Underline.None" Class="d-flex align-center mr-8">
            <MudIcon Icon="@Icons.Material.Filled.ViewInAr" Color="Color.Primary" Class="mr-2" />
            <MudText Typo="Typo.h6" Style="font-weight:700;letter-spacing:-.02em;">
                Mesh<span style="color:var(--mud-palette-primary)">Vault</span>
            </MudText>
        </MudLink>

        <AuthorizeView Context="auth">
            <Authorized>
                <MudNavLink Href="/browse" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.GridView"
                            Class="topnav-link">Browse</MudNavLink>
                <MudNavLink Href="/collections" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.CollectionsBookmark"
                            Class="topnav-link">Collections</MudNavLink>
                <MudNavLink Href="/designers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People"
                            Class="topnav-link">Designers</MudNavLink>
                @if (PaintsOn)
                {
                    <MudNavLink Href="/paints" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Palette"
                                Class="topnav-link">Paints</MudNavLink>
                }
            </Authorized>
        </AuthorizeView>

        @* Libraries, accounts and diagnostics live under Settings rather than
           in the bar. They are opened when something needs configuring or has
           gone wrong, not while browsing, and four admin entries crowded out
           the three that get used daily. *@
        <AuthorizeView Policy="@Policies.Admin" Context="admin">
            <MudNavLink Href="/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings"
                        Class="topnav-link">Settings</MudNavLink>
        </AuthorizeView>

        <MudSpacer />

        <AuthorizeView Context="account">
            <Authorized>
                @* Plain links and a form post, so the bar needs no circuit of
                   its own and works on the statically rendered pages too. *@
                <a class="topbar-account" href="/account">
                    <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Size="Size.Small" />
                    <span>@(account.User.Identity?.Name)</span>
                </a>
                <form method="post" action="/account/logout" class="logout-form">
                    <AntiforgeryToken />
                    <button type="submit" class="logout-button">Sign out</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <a class="topbar-account" href="/login">Sign in</a>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="pa-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    /// <summary>
    /// Whether the painting feature is on, read once per page.
    /// </summary>
    /// <remarks>
    /// The bar is statically rendered, so this is a single small query per
    /// request rather than anything live: turning the feature on or off shows
    /// up on the next navigation.
    /// </remarks>
    private bool PaintsOn;

    protected override async Task OnInitializedAsync() =>
        PaintsOn = await Settings.GetBoolAsync(SettingKeys.PaintsEnabled);

    public static readonly MudTheme Theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#4a9eff",
            Secondary = "#7ddba4",
            Background = "#14161a",
            BackgroundGray = "#0f1114",
            Surface = "#1c1f25",
            AppbarBackground = "#1c1f25",
            AppbarText = "#e6e8ec",
            DrawerBackground = "#1c1f25",
            TextPrimary = "#e6e8ec",
            TextSecondary = "#8b93a1",
            ActionDefault = "#8b93a1",
            Divider = "#2e333d",
            DividerLight = "#2e333d",
            LinesDefault = "#2e333d",
            TableLines = "#2e333d",
            Error = "#e05252",
            Warning = "#f5c542",
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "8px",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Inter", "ui-sans-serif", "system-ui", "Segoe UI", "sans-serif"],
            },
        },
    };
}
